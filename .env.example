# Copy to .env (docker-compose loads it automatically). Never commit the
# real .env - only this example file is tracked.

# Signs JWTs (login tokens + QR tokens). Use a long random string in any
# environment that isn't your own machine.
SECRET_KEY=change-me-to-a-long-random-string

# Host-side ports. Override if 8000/5173 are already taken.
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Comma-separated list of origins allowed to call the API directly
# (cross-origin). Not needed for the normal Docker Compose path, where the
# browser only ever talks to the frontend's own origin and nginx proxies
# /api/* to the backend same-origin.
CORS_ORIGINS=http://localhost:5173

# Optional: override the auto-generated password for a real account when
# running `docker compose exec backend python -m scripts.seed`. Leave unset
# to let the script generate a strong random one (printed once, saved to
# the gitignored CREDENTIALS.md).
# SEED_ADMIN_PASSWORD=
# SEED_TEACHER_PASSWORD=
# SEED_STUDENT_PASSWORD=
# SEED_SECURITY_PASSWORD=
